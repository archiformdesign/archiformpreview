# Copy this file to .env.local for local development, and add the same values in the live host
# (Hostinger hPanel → the Node.js app → Environment variables; on Vercel: Project → Settings → Environment Variables).

# Resend (https://resend.com) – sends contact-form enquiries to your inbox
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where enquiries are delivered (comma-separate for several inboxes)
CONTACT_TO_EMAIL=hello@archiformdesign.me
# Sender. Use an address on a domain you've verified in Resend.
# Until then, "ARCHIFORM <onboarding@resend.dev>" works but only delivers to your Resend sign-up email.
CONTACT_FROM_EMAIL=ARCHIFORM Website <onboarding@resend.dev>

# Your live domain, used for SEO links and the sitemap
NEXT_PUBLIC_SITE_URL=https://archiformdesign.me

# Sanity CMS (public identifiers; safe in the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=d41h1npy
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: defaults to the date in sanity/env.js
# NEXT_PUBLIC_SANITY_API_VERSION=2026-11-21

# Sanity write token: only for the one-off scripts in scripts/ (run locally with node). The website never needs it.
# Keep it in .env.local only: never in Vercel/Hostinger, never with a NEXT_PUBLIC_ prefix, never committed.
SANITY_API_WRITE_TOKEN=

# Sanity read token for draft preview (the Studio's Presentation tool). Create it at sanity.io/manage → project → API →
# Tokens with the **Viewer** role. Server-only: add it here and in the live host's environment variables, never with a
# NEXT_PUBLIC_ prefix. Without it the site still works; only previewing unpublished drafts is off.
SANITY_API_READ_TOKEN=
